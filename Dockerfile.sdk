# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 ubuntu:24.04

LABEL maintainer="MihoWRT Maintainers"
LABEL description="Official OpenWrt 25.12.6 SDK and Linux test container for MihoWRT"

ENV DEBIAN_FRONTEND=noninteractive \
    FORCE_UNSAFE_CONFIGURE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install OpenWrt SDK compilation prerequisites and test utilities (nodejs, jq, shellcheck, bash)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    bzip2 \
    ca-certificates \
    curl \
    file \
    gawk \
    gcc \
    g++ \
    gettext \
    git \
    jq \
    libelf-dev \
    libncurses-dev \
    libssl-dev \
    make \
    nodejs \
    patch \
    pkg-config \
    python3 \
    python3-setuptools \
    rsync \
    shellcheck \
    tar \
    unzip \
    wget \
    which \
    xz-utils \
    zlib1g-dev \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# Configure git identity for OpenWrt SDK internal init and safe directory handling
RUN git config --global user.email "builder@mihowrt.local" && \
    git config --global user.name "MihoWRT Builder" && \
    git config --global --add safe.directory '*'

WORKDIR /workspace

CMD ["/bin/bash"]
