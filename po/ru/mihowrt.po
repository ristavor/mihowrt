msgstr "Обзор"

msgid "Auto — %s"
msgstr "Авто — %s"

msgid "Configuration is unchanged."
msgstr "Конфигурация не изменилась."

msgid "Configuration not checked yet (it is checked at start)"
msgstr "Конфигурация ещё не проверялась (проверка при запуске)"

msgid "DNS mode"
msgstr "Режим DNS"

msgid "Devices always direct"
msgstr "Устройства всегда напрямую"

msgid "Disabled"
msgstr "Выключено"

msgid "Enabled"
msgstr "Включено"

msgid "Link to a Clash/Mihomo (YAML) subscription from your provider. Leave empty to manage the YAML yourself."
msgstr "Ссылка на подписку Clash/Mihomo (YAML) от VPN-сервиса. Оставьте пустой, чтобы вести YAML самостоятельно."

msgid "MihoWRT manages ports, routing mark, TUN, the controller and the dashboard itself; those keys are overridden. Updating the subscription, including automatic updates, replaces this file."
msgstr "MihoWRT сам управляет портами, меткой маршрутизации, TUN, контроллером и панелью; эти ключи переопределяются. Обновление подписки, в том числе автоматическое, заменяет этот файл."

msgid "Mihomo says: %s"
msgstr "Ответ Mihomo: %s"

msgid "Mihomo spreads connections across these servers"
msgstr "Mihomo распределяет соединения по этим серверам"

msgid "My entries"
msgstr "Мои записи"

msgid "Only mine"
msgstr "Только мой список"

msgid "Only when you press Update now."
msgstr "Только по кнопке «Обновить сейчас»."

msgid "Paste the Clash/Mihomo (YAML) subscription link from your VPN provider. MihoWRT downloads the configuration, checks it and starts routing."
msgstr "Вставьте ссылку на подписку Clash/Mihomo (YAML) от VPN-сервиса. MihoWRT скачает конфигурацию, проверит её и включит маршрутизацию."

msgid "Provider list + mine"
msgstr "Список из подписки + мой"

msgid "Provider lists"
msgstr "Списки из подписки"

msgid "Provider settings"
msgstr "Настройки из подписки"

msgid "Set by your provider."
msgstr "Задано подпиской."

msgid "Subscription is up to date."
msgstr "Подписка уже актуальна."

msgid "Unknown:"
msgstr "Неизвестно:"

msgid "Update automatically"
msgstr "Обновлять автоматически"

msgid "Use my own value"
msgstr "Использовать своё значение"

msgid "Your provider decides how often (now every %d h)."
msgstr "Частоту задаёт подписка (сейчас каждые %d ч)."

msgid "Your provider does not set an update period, so the subscription is updated only when you press Update now."
msgstr "Подписка не задаёт период обновления, поэтому она обновляется только по кнопке «Обновить сейчас»."

msgid "direct %d"
msgstr "напрямую %d"

msgid "none"
msgstr "нет"

msgid "proxy %d, devices %d, direct %d, direct devices %d"
msgstr "прокси %d, устройства %d, напрямую %d, устройства напрямую %d"

msgid "via proxy %d"
msgstr "через прокси %d"

msgid "%s (priority %s)"
msgstr "%s (приоритет %s)"

msgid "(chosen by your subscription)"
msgstr "(выбрано подпиской)"

msgid "(follows the DNS settings of your YAML)"
msgstr "(по настройкам DNS в вашем YAML)"

msgid "All servers in turn"
msgstr "Все серверы по очереди"

msgid "Configuration has errors"
msgstr "В конфигурации есть ошибки"

msgid "Hide details"
msgstr "Скрыть подробности"

msgid "Hide the YAML editor"
msgstr "Скрыть редактор YAML"

