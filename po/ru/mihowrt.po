msgid "Unknown error"
msgstr "Неизвестная ошибка"

msgid "Unexpected response from the router: %s"
msgstr "Неожиданный ответ роутера: %s"

msgid "Unlimited"
msgstr "Безлимит"

msgid "Mihomo core installed"
msgstr "Ядро Mihomo установлено"

msgid "Open Overview and install the core."
msgstr "Откройте «Обзор» и установите ядро."

msgid "Configuration is valid"
msgstr "Конфигурация корректна"

msgid "Update the subscription or fix the YAML on the Subscription page."
msgstr "Обновите подписку или исправьте YAML на странице «Подписка»."

msgid "Subscription configured"
msgstr "Подписка настроена"

msgid "Without a subscription only the YAML you entered is used."
msgstr "Без подписки используется только введённый вами YAML."

msgid "Service is running"
msgstr "Сервис запущен"

msgid "Press Start on Overview. If it stops again, check the log below."
msgstr "Нажмите «Запустить» на странице «Обзор». Если он снова остановится, посмотрите журнал ниже."

msgid "Mihomo answers DNS queries"
msgstr "Mihomo отвечает на DNS-запросы"

msgid "Mihomo cannot resolve names: check that the proxy servers and DNS servers in the config are reachable."
msgstr "Mihomo не может разрешать имена: проверьте, что прокси-серверы и DNS-серверы из конфигурации доступны."

msgid "Traffic rules are active"
msgstr "Правила трафика активны"

msgid "Restart the service; if it persists, see the log."
msgstr "Перезапустите сервис; если не поможет, посмотрите журнал."

msgid "dnsmasq has its own upstream servers: %s"
msgstr "У dnsmasq заданы собственные DNS-серверы: %s"

msgid "These servers answer next to Mihomo, so some sites may bypass the proxy. Move them to the Mihomo YAML (dns.nameserver) and remove them from Network → DHCP and DNS."
msgstr "Эти серверы отвечают наравне с Mihomo, поэтому часть сайтов может идти мимо прокси. Перенесите их в YAML Mihomo (dns.nameserver) и удалите в «Сеть → DHCP и DNS»."

