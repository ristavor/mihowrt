msgstr "Диагностика"

msgid "Details"
msgstr "Подробности"

msgid "All traffic via proxy except exclusions"
msgstr "Весь трафик через прокси, кроме исключений"

msgid "Only selected traffic via proxy"
msgstr "Через прокси только выбранное"

msgid "Subscription URL"
msgstr "Ссылка на подписку"

msgid "Connect"
msgstr "Подключить"

msgid "Enter the subscription link that starts with https://"
msgstr "Введите ссылку на подписку, начинающуюся с https://"

msgid "Subscription connected. MihoWRT is starting."
msgstr "Подписка подключена. MihoWRT запускается."

msgid "Connect a subscription"
msgstr "Подключите подписку"

msgid "Paste the link from your VPN provider. MihoWRT downloads the configuration, checks it and starts routing."
msgstr "Вставьте ссылку от вашего VPN-провайдера. MihoWRT скачает конфигурацию, проверит её и включит маршрутизацию."

msgid "Install Mihomo core"
msgstr "Установить ядро Mihomo"

msgid "Mihomo core %s installed."
msgstr "Ядро Mihomo %s установлено."

msgid "Mihomo core is not installed"
msgstr "Ядро Mihomo не установлено"

msgid "MihoWRT needs the Mihomo core (about 20 MB download, about 60 MB on flash)."
msgstr "Для работы нужно ядро Mihomo (загрузка около 20 МБ, на флеш-памяти около 60 МБ)."

