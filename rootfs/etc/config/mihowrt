config settings 'settings'
	list source_network_interfaces 'br-lan'
	option dns_hijack '1'
	option disable_quic '1'
	option netbird_proxy '0'
	option bypass_ntp '1'
	option bypass_subscription_dns '1'
	option block_client_ipv6 '0'
	option subscription_url ''
	option subscription_auto_update '1'
	option lists_interval '24'
	option mihomo_log_level 'error'
