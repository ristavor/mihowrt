#!/bin/sh

. /usr/lib/mihowrt/constants.sh

# WAN came up: refresh DNS bypass and connected networks, or restart an
# enabled service that procd gave up on (e.g. watchdog during a long outage).
# A service stopped by the user (Stop) stays stopped until Start or reboot.
case "$ACTION" in
ifup | ifupdate) ;;
*) exit 0 ;;
esac

if [ -f "$RUNNING_MARKER" ]; then
	/usr/bin/mihowrt net-refresh 9>&- >/dev/null 2>&1 &
elif [ "$ACTION" = ifup ] && [ ! -f "$USER_STOP_FILE" ] && /etc/init.d/mihowrt enabled &&
	! pgrep -f "$SUPERVISOR_CMD" >/dev/null 2>&1; then
	/etc/init.d/mihowrt start 9>&- >/dev/null 2>&1 &
fi
