#!/bin/sh /etc/rc.common

START=21
STOP=79
USE_PROCD=1

# Do not pass a caller's runtime lock to procd or its supervisor.
exec 9>&-

MIHOWRT="/usr/bin/mihowrt"
SKIP_START_FILE="/tmp/luci-app-mihowrt.skip-start"
. /usr/lib/mihowrt/constants.sh

# Validate everything first so a bad config never touches router state.
start_service() {
	local skip=""

	# Set by the package preinst for the start that apk's default postinst
	# runs. A marker left by a failed install must not block a later Start.
	if [ -f "$SKIP_START_FILE" ]; then
		skip="$(find "$SKIP_START_FILE" -mmin -5 2>/dev/null)"
		rm -f "$SKIP_START_FILE"
		[ -n "$skip" ] && return 0
	fi
	mkdir -p "$PKG_STATE_DIR" || return 1
	rm -f "$USER_STOP_FILE" "$LAST_ERROR_FILE"
	# prepare records its error in LAST_ERROR_FILE; warnings stay quiet.
	"$MIHOWRT" prepare 2>/dev/null || {
		cat "$LAST_ERROR_FILE" >&2
		logger -p daemon.err -t mihowrt "Start aborted: configuration is not valid: $(cat "$LAST_ERROR_FILE" 2>/dev/null)"
		return 1
	}

	procd_open_instance
	# The fixed command in constants.sh intentionally expands to two arguments.
	# shellcheck disable=SC2086
	procd_set_param command $SUPERVISOR_CMD
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Watchdog or crash: retry every 5 s, give up after 5 failures per hour.
	procd_set_param respawn 3600 5 5
	# Cleanup (DNS, nft, routes) must finish before procd escalates to SIGKILL.
	procd_set_param term_timeout 30
	procd_close_instance
}

stop_service() {
	mkdir -p "${USER_STOP_FILE%/*}" && : >"$USER_STOP_FILE"
}

# Make stop synchronous and clear leftovers if run-service was killed.
service_stopped() {
	"$MIHOWRT" wait-stopped >/dev/null 2>&1
}

reload_service() {
	"$MIHOWRT" reload
}

service_triggers() {
	procd_add_reload_trigger "mihowrt"
}
