#!/bin/ash

LIB="${MIHOWRT_LIB_DIR:-/usr/lib/mihowrt}"
. "$LIB/constants.sh" && . "$LIB/helpers.sh" && mihowrt_load_modules || exit 1

usage() {
	cat >&2 <<'EOF'
Usage: mihowrt <command>
Service:  prepare | run-service | wait-stopped | recover | reload | migrate
Config:   read-config [tmp] | save-config <tmp>
Subscr.:  subscription-json | set-subscription <url> <hours|''> | update-subscription
Lists:    apply-lists <dst-tmp> <src-tmp> <direct-tmp> <direct-src-tmp> | update-lists
Updates:  auto-update | dns-refresh | core-update | core-version-json
Status:   status-json | service-state-json | logs-json [lines]
Proxies:  proxies-json | select-proxy <group> <name> | group-delay <group> | dashboard-json
EOF
	exit 1
}

need_args() {
	[ "$1" -eq "$2" ] || usage
}

dashboard_json() {
	settings_load || return 1
	jq -nc --arg host "$(lan_ip_detect)" --arg port "$MIHOMO_API_PORT" --arg secret "$API_SECRET" \
		--argjson running "$(json_bool service_running)" \
		'{host: $host, port: ($port | tonumber), secret: $secret, running: $running}'
}

core_update_cmd() {
	local result="" rc=0

	# The download can take minutes: no runtime lock (nothing in the
	# runtime state changes until the service restarts).
	result="$(core_update_json)" || rc=$?
	printf '%s\n' "$result"
	# Restart outside the lock: stop waits for run-service, which needs it.
	if [ "$rc" -eq 0 ] && [ "$(printf '%s' "$result" | jq -r .updated)" = true ] && service_running; then
		/etc/init.d/mihowrt restart >/dev/null 2>&1 &
	fi
	return "$rc"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
prepare) with_lock service_prepare ;;
run-service) run_service ;;
wait-stopped) service_wait_stopped ;;
recover) with_lock service_recover ;;
reload) with_lock service_reload ;;
migrate) with_lock migrate ;;
read-config) config_read_json "${1:-}" ;;
save-config)
	need_args $# 1
	with_lock config_save "$1"
	;;
subscription-json) subscription_json ;;
set-subscription)
	need_args $# 2
	with_lock subscription_set "$1" "$2"
	;;
update-subscription) subscription_update ;;
apply-lists)
	need_args $# 4
	lists_apply "$1" "$2" "$3" "$4"
	;;
update-lists) lists_refresh ;;
auto-update) auto_update ;;
dns-refresh) with_lock dns_refresh ;;
core-update) core_update_cmd ;;
core-version-json) core_version_json ;;
status-json) status_json ;;
service-state-json) service_state_json ;;
logs-json) logs_json "${1:-200}" ;;
proxies-json) settings_load && api_proxies_json ;;
select-proxy)
	need_args $# 2
	settings_load && api_select "$1" "$2"
	;;
group-delay)
	need_args $# 1
	settings_load && api_group_delay "$1"
	;;
dashboard-json) dashboard_json ;;
*) usage ;;
esac
