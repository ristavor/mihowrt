#!/bin/ash

LIB="${MIHOWRT_LIB_DIR:-/usr/lib/mihowrt}"
. "$LIB/constants.sh" && . "$LIB/helpers.sh" && mihowrt_load_modules || exit 1

usage() {
	cat >&2 <<'EOF'
Usage: mihowrt <command>
Service:  prepare | run-service | wait-stopped | recover | reload | migrate | uninstall
Config:   read-config [tmp] | runtime-config | save-config <tmp> | restore-config
Subscr.:  subscription-json | set-subscription <url> <0|1> | update-subscription [url]
Lists:    lists-json | apply-lists <dst-tmp|-> <src-tmp|-> <direct-tmp|-> <direct-src-tmp|-> | update-lists
Updates:  auto-update | net-refresh | core-update | core-version-json
Status:   status-json | service-state-json | profile-json | diagnostics-json | logs-json [lines]
Jobs:     job-start <op> [args] | job-status [id]
Proxies:  proxies-json | select-proxy <group> <name|''> | group-delay <group> | dashboard-json
EOF
	exit 1
}

need_args() {
	[ "$1" -eq "$2" ] || usage
}

dashboard_json() {
	settings_load || return 1
	jq -nc --arg host "$(lan_ip_detect)" --arg port "$MIHOMO_API_PORT" --arg secret "$API_SECRET" \
		--argjson running "$(json_bool service_running)" \
		'{host: $host, port: ($port | tonumber), secret: $secret, running: $running}'
}

core_update_cmd() {
	local result="" rc=0 restarted=false restart_error="" out=""

	# The download can take minutes: no runtime lock (nothing in the
	# runtime state changes until the service restarts). fd 7 keeps a second
	# core update out.
	ensure_dir "$PKG_STATE_DIR" || return 1
	exec 7>>"$PKG_STATE_DIR/core.flock"
	if ! flock -n 7; then
		exec 7>&-
		err "Another core update is running"
		jq -nc --arg v "$(core_version)" \
			'{updated: false, version: $v, error: "Another core update is running", restarted: false}'
		return 1
	fi
	result="$(core_update_json)" || rc=$?
	flock -u 7
	exec 7>&-
	# Restart outside the lock: stop waits for run-service, which needs it.
	if [ "$rc" -eq 0 ] && [ "$(printf '%s' "$result" | jq -r .updated)" = true ] && service_running; then
		if out="$(/etc/init.d/mihowrt restart 2>&1 >/dev/null 9>&-)"; then
			restarted=true
		else
			out="$(printf '%s\n' "$out" | awk 'NF { l = $0 } END { sub(/^Error: /, "", l); print l }')"
			restart_error="Mihomo core updated, but the service restart failed${out:+: $out}"
			err "$restart_error"
			rc=1
		fi
	fi
	printf '%s\n' "$result" | jq -c --argjson restarted "$restarted" --arg e "$restart_error" \
		'. + {restarted: $restarted} | if $e == "" then . else .error = $e end'
	return "$rc"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
job-start) job_start "$@" ;;
job-run) job_run "$@" ;;
job-status) job_status "$@" ;;
prepare) service_prepare_cmd ;;
run-service) run_service ;;
wait-stopped) service_wait_stopped ;;
recover) with_lock service_recover ;;
uninstall)
	need_args $# 0
	# Stop waits for run-service, which needs the runtime lock for cleanup.
	/etc/init.d/mihowrt stop 9>&- >/dev/null 2>&1 || true
	with_lock uninstall_cleanup
	;;
reload) with_lock service_reload ;;
migrate) with_lock migrate ;;
read-config) config_read_json "${1:-}" ;;
runtime-config)
	need_args $# 0
	runtime_config_json
	;;
save-config)
	need_args $# 1
	# Wait for a starting Mihomo before taking the lock.
	settings_load >/dev/null 2>&1 && config_api_wait
	with_lock config_save "$1"
	;;
restore-config) with_lock config_restore ;;
subscription-json) subscription_json ;;
set-subscription)
	need_args $# 2
	with_lock subscription_set "$1" "$2"
	;;
update-subscription)
	[ $# -le 1 ] || usage
	subscription_update "${1:-}"
	;;
lists-json)
	need_args $# 0
	lists_json
	;;
apply-lists)
	need_args $# 4
	lists_apply "$1" "$2" "$3" "$4"
	;;
update-lists) lists_refresh ;;
auto-update) auto_update ;;
net-refresh) with_lock net_refresh ;;
core-update) core_update_cmd ;;
core-version-json) core_version_json ;;
diagnostics-json)
	need_args $# 0
	diagnostics_json
	;;
status-json) status_json ;;
profile-json) profile_json ;;
service-state-json) service_state_json ;;
logs-json) logs_json "${1:-200}" ;;
proxies-json) settings_load && api_proxies_json ;;
select-proxy)
	need_args $# 2
	settings_load && api_select "$1" "$2"
	;;
group-delay)
	need_args $# 1
	settings_load && api_group_delay "$1"
	;;
dashboard-json) dashboard_json ;;
*) usage ;;
esac
