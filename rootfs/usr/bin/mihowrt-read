#!/bin/ash

# Read-only entry point for the LuCI read ACL. Mutating commands need the
# write ACL and /usr/bin/mihowrt.
BACKEND="${MIHOWRT_BACKEND:-/usr/bin/mihowrt}"

case "${1:-}" in
read-config)
	[ $# -le 2 ] || exit 1
	case "${2:-}" in
	'' | /tmp/mihowrt-config.*) ;;
	*)
		echo "Error: read-config path must be a MihoWRT temp config" >&2
		exit 1
		;;
	esac
	;;
job-status)
	[ $# -le 2 ] || exit 1
	if [ $# -eq 2 ]; then
		case "$2" in
		*-*)
			case "${2%%-*}" in '' | *[!0-9]*) exit 1 ;; esac
			case "${2#*-}" in '' | *[!0-9]*) exit 1 ;; esac
			;;
		*) exit 1 ;;
		esac
	fi
	;;
logs-json) [ $# -le 2 ] || exit 1 ;;
runtime-config | lists-json | status-json | service-state-json | subscription-json | core-version-json | proxies-json | profile-json | diagnostics-json)
	[ $# -eq 1 ] || exit 1
	;;
*)
	echo "Usage: $0 {read-config [tmp]|runtime-config|lists-json|status-json|service-state-json|subscription-json|core-version-json|proxies-json|profile-json|diagnostics-json|logs-json [lines]|job-status [id]}" >&2
	exit 1
	;;
esac

exec "$BACKEND" "$@"
