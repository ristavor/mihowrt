#!/bin/ash

# Read-only entry point for the LuCI read ACL. Mutating commands need the
# write ACL and /usr/bin/mihowrt.
BACKEND="${MIHOWRT_BACKEND:-/usr/bin/mihowrt}"

case "${1:-}" in
read-config)
	[ $# -le 2 ] || exit 1
	case "${2:-}" in
	'' | /tmp/mihowrt-config.*) ;;
	*)
		echo "Error: read-config path must be a MihoWRT temp config" >&2
		exit 1
		;;
	esac
	;;
logs-json) [ $# -le 2 ] || exit 1 ;;
status-json | service-state-json | subscription-json | core-version-json | proxies-json)
	[ $# -eq 1 ] || exit 1
	;;
*)
	echo "Usage: $0 {read-config [tmp]|status-json|service-state-json|subscription-json|core-version-json|proxies-json|logs-json [lines]}" >&2
	exit 1
	;;
esac

exec "$BACKEND" "$@"
