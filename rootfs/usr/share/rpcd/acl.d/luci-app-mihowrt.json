{
	"luci-app-mihowrt": {
		"description": "Grant access to MihoWRT procedures",
		"read": {
			"file": {
				"/usr/bin/mihowrt-read": [ "exec" ]
			},
			"ubus": {
				"file": [ "read", "exec" ],
				"luci-rpc": [ "getDHCPLeases" ]
			},
			"uci": [ "mihowrt" ]
		},
		"write": {
			"file": {
				"/usr/bin/mihowrt": [ "exec" ],
				"/etc/init.d/mihowrt": [ "exec" ],
				"/tmp/mihowrt-config.*": [ "write" ],
				"/tmp/mihowrt-policy-list.*": [ "write" ]
			},
			"ubus": {
				"file": [ "write", "exec" ]
			},
			"uci": [ "mihowrt" ]
		}
	}
}
