add table inet mihowrt
delete table inet mihowrt
add table inet mihowrt
add set inet mihowrt proxy_dst { type ipv4_addr; flags interval; auto-merge; }
add set inet mihowrt proxy_src { type ipv4_addr; flags interval; auto-merge; }
add set inet mihowrt direct_dst { type ipv4_addr; flags interval; auto-merge; }
add set inet mihowrt direct_src { type ipv4_addr; flags interval; auto-merge; }
add set inet mihowrt localv4 { type ipv4_addr; flags interval; auto-merge; }
add set inet mihowrt proxy_dst6 { type ipv6_addr; flags interval; auto-merge; }
add set inet mihowrt proxy_src6 { type ipv6_addr; flags interval; auto-merge; }
add set inet mihowrt direct_dst6 { type ipv6_addr; flags interval; auto-merge; }
add set inet mihowrt direct_src6 { type ipv6_addr; flags interval; auto-merge; }
add set inet mihowrt localv6 { type ipv6_addr; flags interval; auto-merge; }
add set inet mihowrt proxy_src_mac { type ether_addr; }
add set inet mihowrt direct_src_mac { type ether_addr; }
add set inet mihowrt source_ifaces { type ifname; }
add set inet mihowrt bypass_dst { type ipv4_addr; flags timeout; }
add set inet mihowrt bypass_dst6 { type ipv6_addr; flags timeout; }
add element inet mihowrt localv4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }
add element inet mihowrt localv6 { ::/127, fe80::/10, fc00::/7, ff00::/8 }
add element inet mihowrt localv4 { 203.0.113.0/24 }
add element inet mihowrt localv6 { 2001:db8:1:10::/64 }
add element inet mihowrt localv6 { 2001:db8:1:20::/64 }
add element inet mihowrt localv6 { 2001:db8:1::/48 }
add element inet mihowrt localv6 { 2001:db8:2::/48 }
add element inet mihowrt localv6 { 2001:db8:4::1 }
add element inet mihowrt source_ifaces { "br-lan" }
add chain inet mihowrt dns_hijack { type nat hook prerouting priority dstnat; policy accept; }
add chain inet mihowrt mangle_prerouting { type filter hook prerouting priority mangle; policy accept; }
add chain inet mihowrt prerouting_policy
add chain inet mihowrt mangle_output { type route hook output priority mangle; policy accept; }
add chain inet mihowrt proxy_redirect { type filter hook prerouting priority dstnat; policy accept; }
add element inet mihowrt direct_dst { 77.88.8.8 }
add element inet mihowrt direct_dst6 { 2a02:6b8::/32 }
add element inet mihowrt direct_src { 192.168.1.50 }
add element inet mihowrt direct_src6 { fd00::50 }
add rule inet mihowrt dns_hijack iifname "wt0" return
add rule inet mihowrt dns_hijack fib daddr type local return
add rule inet mihowrt dns_hijack iifname @source_ifaces ip daddr != @localv4 meta l4proto { tcp, udp } th dport 53 redirect to :7874
add rule inet mihowrt dns_hijack iifname @source_ifaces ip6 daddr != @localv6 meta l4proto { tcp, udp } th dport 53 redirect to :7874
add rule inet mihowrt mangle_prerouting iifname "wt0" return
add rule inet mihowrt mangle_prerouting iifname @source_ifaces jump prerouting_policy
add rule inet mihowrt prerouting_policy fib daddr type local return
add rule inet mihowrt prerouting_policy ip daddr @localv4 return
add rule inet mihowrt prerouting_policy ip6 daddr @localv6 return
add rule inet mihowrt prerouting_policy meta mark & 0x08000000 == 0x08000000 return
add rule inet mihowrt prerouting_policy meta nfproto ipv6 udp dport 123 return
add rule inet mihowrt prerouting_policy ip daddr != 198.18.0.0/16 udp dport 123 return
add rule inet mihowrt prerouting_policy meta l4proto { tcp, udp } th dport 53 return
add rule inet mihowrt prerouting_policy ip daddr @direct_dst return
add rule inet mihowrt prerouting_policy ip6 daddr @direct_dst6 return
add rule inet mihowrt prerouting_policy ip saddr @direct_src return
add rule inet mihowrt prerouting_policy ip6 saddr @direct_src6 return
add rule inet mihowrt prerouting_policy udp dport 443 reject
add rule inet mihowrt prerouting_policy meta l4proto { tcp, udp } meta mark set meta mark | 0x08000000
add rule inet mihowrt proxy_redirect iifname "wt0" return
add rule inet mihowrt proxy_redirect meta mark & 0x08000000 == 0x08000000 meta nfproto ipv4 meta l4proto { tcp, udp } tproxy ip to 127.0.0.1:7894
add rule inet mihowrt proxy_redirect meta mark & 0x08000000 == 0x08000000 meta nfproto ipv6 meta l4proto { tcp, udp } tproxy ip6 to [::1]:7894
add rule inet mihowrt mangle_output meta mark 2 return
add rule inet mihowrt mangle_output meta l4proto { tcp, udp } th dport 7894 return
add rule inet mihowrt mangle_output fib daddr type local return
add rule inet mihowrt mangle_output ip daddr @localv4 return
add rule inet mihowrt mangle_output ip6 daddr @localv6 return
add rule inet mihowrt mangle_output meta mark & 0x08000000 == 0x08000000 return
add rule inet mihowrt mangle_output meta nfproto ipv6 udp dport 123 return
add rule inet mihowrt mangle_output ip daddr != 198.18.0.0/16 udp dport 123 return
add rule inet mihowrt mangle_output meta l4proto { tcp, udp } th dport 53 return
add rule inet mihowrt mangle_output ip daddr @bypass_dst return
add rule inet mihowrt mangle_output ip6 daddr @bypass_dst6 return
add rule inet mihowrt mangle_output meta mark & 0x40000000 == 0x40000000 return
add rule inet mihowrt mangle_output meta mark & 0x20000000 == 0x20000000 return
add rule inet mihowrt mangle_output meta mark { 0x1bd00, 0x1bd10, 0x1bd11, 0x1bd20, 0x1bd21, 0x1bd22 } return
add rule inet mihowrt mangle_output ip daddr @direct_dst return
add rule inet mihowrt mangle_output ip6 daddr @direct_dst6 return
add rule inet mihowrt mangle_output udp dport 443 reject
add rule inet mihowrt mangle_output meta l4proto { tcp, udp } meta mark set meta mark | 0x08000000
