# Test seams remain in source; shipped entrypoints clear them before loading code.
# The init script only gets a fixed PATH (its marker is MIHOWRT_PACKAGE_HARDEN_PATH).
/^# MIHOWRT_PACKAGE_HARDEN$/c\
unset MIHOWRT_BACKEND MIHOWRT_LIB_DIR SUBSCRIPTION_META_FILE JOB_PROC_DIR ROUTE_PROC_ROOT RC_D_DIR LOCK_DEPTH SETTINGS_LOADED SETTINGS_UCI_SNAPSHOT NET_REFRESH_DELAY DASHBOARD_WAIT_SECONDS RUNTIME_LOCK_TIMEOUT API_DELAY_URL SUBSCRIPTION_MAX_BYTES SUBSCRIPTION_TIMEOUT LISTS_REMOTE_MAX_BYTES LISTS_REMOTE_MAX_URLS LISTS_REMOTE_TIMEOUT MIHOWRT_QUIET MIHOWRT_STOP https_proxy HTTPS_PROXY http_proxy HTTP_PROXY ALL_PROXY all_proxy no_proxy NO_PROXY CURL_CA_BUNDLE SSL_CERT_FILE SSL_CERT_DIR CURL_HOME\
PATH=/usr/sbin:/usr/bin:/sbin:/bin\
export PATH
/^# MIHOWRT_PACKAGE_HARDEN_PATH$/c\
PATH=/usr/sbin:/usr/bin:/sbin:/bin\
export PATH
s|^LIB=.*|LIB=/usr/lib/mihowrt|
s|^BACKEND=.*|BACKEND=/usr/bin/mihowrt|
s|"${MIHOWRT_LIB_DIR:-/usr/lib/mihowrt}"|/usr/lib/mihowrt|
